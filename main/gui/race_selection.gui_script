local druid = require("druid.druid")
require("main.scripts.modules.constants")

--- Handle Human race selection
---@param self table
local function select_human(self)
	print("[Race Selection] Player selected: Human")
	msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, {
		level = 1,
		player_class = self.player_class,
		player_race = "human"
	})
end

--- Handle Elf race selection
---@param self table
local function select_elf(self)
	print("[Race Selection] Player selected: Elf")
	msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, {
		level = 1,
		player_class = self.player_class,
		player_race = "elf"
	})
end

--- Handle Dwarf race selection
---@param self table
local function select_dwarf(self)
	print("[Race Selection] Player selected: Dwarf")
	msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, {
		level = 1,
		player_class = self.player_class,
		player_race = "dwarf"
	})
end

--- Handle Halfling race selection
---@param self table
local function select_halfling(self)
	print("[Race Selection] Player selected: Halfling")
	msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, {
		level = 1,
		player_class = self.player_class,
		player_race = "halfling"
	})
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.druid = druid.new(self)

	-- Create buttons for each race
	self.druid:new_button("human_button", select_human)
	self.druid:new_button("elf_button", select_elf)
	self.druid:new_button("dwarf_button", select_dwarf)
	self.druid:new_button("halfling_button", select_halfling)

	-- Will be set by message from class selection
	self.player_class = "fighter"

	print("[Race Selection] UI initialized")
end

function final(self)
	msg.post(".", "release_input_focus")
	self.druid:final()
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_class") then
		self.player_class = message.class
		print("[Race Selection] Class set to: " .. self.player_class)
	end

	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end
