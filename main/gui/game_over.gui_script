require("main.scripts.modules.constants")
local druid = require("druid.druid")

local function restart_click(self)
  msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, { level = 1 })
end

local function menu_click(self)
  msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, { level = "menu" })
end

function init(self)
  msg.post(".", "acquire_input_focus")
  self.druid = druid.new(self)
  self.druid:new_button("restart", restart_click)
  self.druid:new_button("menu", menu_click)
  sound.play("music#sound")
end

function final(self)
  msg.post(".", "release_input_focus")
  self.druid:final()
  sound.stop("music#sound")
end

function on_message(self, message_id, message, sender)
  self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
  return self.druid:on_input(action_id, action)
end

