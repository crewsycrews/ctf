require("main.scripts.modules.messages")

function init(self)
  self.fireball = gui.get_node("fireball")
  self.ice = gui.get_node("ice")
  self.player_health = gui.get_node("player_health")
end

local function handle_animation(message_id, node, animation)
  if message_id == hash(animation) then gui.play_flipbook(node, animation) end
end

local function set_player_health(self, value)
  local size = gui.get_size(self.player_health)
  gui.set_size(self.player_health, vmath.vector3(value, size.y, 0))
end

function on_message(self, message_id, message, sender)
  handle_animation(message_id, self.fireball, MESSAGES.SKILLS.FIREBALL.NORMAL)
  handle_animation(message_id, self.fireball, MESSAGES.SKILLS.FIREBALL.COOLDOWN)
  handle_animation(message_id, self.ice, MESSAGES.SKILLS.ICE.NORMAL)
  handle_animation(message_id, self.ice, MESSAGES.SKILLS.ICE.COOLDOWN)

  if message_id == hash(MESSAGES.PLAYER.SET_HEALTH) then
    set_player_health(self, message.health_percent)
  end
end

