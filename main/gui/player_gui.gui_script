local UI = require("main.scripts.modules.ui")
local C = require("main.scripts.modules.catalog")
local Runtime = require("main.scripts.modules.runtime")
function init(self)
  self.root = UI.root()
  UI.box(self.root, 132, 613, 244, 34, vmath.vector4(0.06, 0.1, 0.08, 0.7))
  self.health = UI.text(self.root, 22, 613, "", 232, 0.9)
  UI.box(self.root, 783, 613, 334, 34, vmath.vector4(0.06, 0.1, 0.08, 0.7))
  self.objective = UI.text(self.root, 630, 613, "", 310, 0.9)
  self.boss = UI.text(self.root, 630, 578, "", 310, 0.9)
  self.head = UI.text(self.root, 20, 24, "", 410, 0.8)
  self.tail = UI.text(self.root, 448, 24, "", 500, 0.8)
  self.combo = UI.text(self.root, 280, 62, "", 620, 0.9, vmath.vector4(1, 0.84, 0.4, 1))
end
function update(self, dt)
  local w = Runtime.get()
  if not w then return end
  UI.fit(self.root)
  gui.set_text(self.health, "HP " .. math.ceil(w.head.health) .. "/100" ..
    (w.head.shield > 0 and ("   Shield " .. math.ceil(w.head.shield)) or ""))
  local level = w.run.level
  gui.set_text(self.objective, "Level " .. level.number .. "   " .. math.min(w.run.kills, level.target) .. "/" .. level.target ..
    (level.boss and " + Boss" or " monsters"))
  local boss = ""
  for _, enemy in pairs(w.enemies) do
    if enemy.boss and not enemy.dead then boss = "GUARDIAN   HP " .. math.ceil(enemy.health) end
  end
  gui.set_text(self.boss, boss)
  local heads, tails = {}, {}
  local keys = { dash = "SPACE", jump = "Q", backward_dash = "E" }
  for _, action in ipairs(C.actions) do
    local ready = math.max(0, ((w.head.ready or {})[action] or 0) - w.time)
    heads[#heads + 1] = keys[action] .. (w.run.head[action] and (":" .. C.names[w.run.head[action]]) or "") ..
      (ready > 0 and string.format(" %.1f", ready) or "")
  end
  local binds = { fire = "LMB", water = "Wheel-", wind = "RMB", earth = "Wheel+" }
  for _, element in ipairs(C.elements) do
    for _, follower in pairs(w.followers) do
      if follower.element == element then
        local ready = math.max(0, (follower.ready or 0) - w.time)
        tails[#tails + 1] = binds[element] .. ":" .. C.names[element] .. (ready > 0 and string.format(" %.1f", ready) or "")
      end
    end
  end
  gui.set_text(self.head, table.concat(heads, "   "))
  gui.set_text(self.tail, table.concat(tails, "   "))
  gui.set_text(self.combo, w.reaction_until > w.time and w.reaction or "")
end
