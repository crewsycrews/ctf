function init(self)
  self.fireball = gui.get_node("fireball")
  self.ice = gui.get_node("ice")
  self.player_health = gui.get_node("player_health")
end

local function handle_animation(message_id, node, animation)
  if message_id == hash(animation) then gui.play_flipbook(node, animation) end
end

local function set_player_health(self, value)
  local size = gui.get_size(self.player_health)
  gui.set_size(self.player_health, vmath.vector3(value, size.y, 0))
end

function on_message(self, message_id, message, sender)
  handle_animation(message_id, self.fireball, "fireball")
  handle_animation(message_id, self.fireball, "fireball_cooldown")
  handle_animation(message_id, self.ice, "ice")
  handle_animation(message_id, self.ice, "ice_cooldown")

  if message_id == hash("set_player_health") then
    set_player_health(self, message.health_percent)
  end
end

