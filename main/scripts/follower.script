---@class Follower
---@field speed number
---@field dir quaternion|vector3|vector4
---@field max_distance number
---@field parent url
---@field type string
require("main.scripts.common.get_world_rotation")
local followers = require("main.scripts.modules.followers")
local skills = require("main.scripts.modules.skills")

go.property('speed', 290)
go.property('parent', msg.url())
go.property('type', 1)
go.property('max_distance', 40)

---@param self Follower
function init(self)
  self.dir = vmath.vector3(1, 0, 0)
  self.pointer = vmath.vector3(0, 0, 0)
  msg.post("#sprite", "play_animation", { id = hash(ELEMENTS[self.type]) })
  msg.post(".", "acquire_input_focus")
end

---@param self Follower
local function check_distance(self, dt)
  local currentPosition = go.get_position()
  self.speed = go.get(self.parent, "speed")
  local whoToFollow = go.get_world_position(self.parent)
  local distance = vmath.length(currentPosition - whoToFollow)
  if distance > self.max_distance then
    local direction = vmath.normalize(whoToFollow - currentPosition) *
                          ((distance - self.max_distance) / 10)
    local target_position = currentPosition + direction * self.speed * dt
    go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, target_position,
               go.EASING_OUTBOUNCE, 0.05)
  end
end

local function checkRotation(self)
  go.set_rotation(get_world_rotation(self.pointer.x, self.pointer.y))
end

---@param self Follower
function update(self, dt)
  check_distance(self, dt)
  checkRotation(self)
end

function on_input(self, action_id, action)
  if not action_id then
    self.pointer.x = action.x
    self.pointer.y = action.y
  end
  if action_id == hash("scroll_down") and ELEMENTS[self.type] == "water" then
    skills.ice_barrage(self)
  end
  if action_id == hash("touch") and ELEMENTS[self.type] == "fire" then
    skills.fireball(self)
  end
  if action_id == hash("scroll_up") and ELEMENTS[self.type] == "earth" then
    skills.thunderclap(self)
  end
  if action_id == hash("tail_action_2") and ELEMENTS[self.type] == "wind" then
    skills.windwalk(self)
  end
end
