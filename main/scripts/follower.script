require("main.scripts.common.get_world_rotation")
local C = require("main.scripts.modules.catalog")
local Skills = require("main.scripts.modules.skills")
local Runtime = require("main.scripts.modules.runtime")
local Combat = require("main.scripts.modules.combat")
go.property("speed", 200)
go.property("parent", msg.url())
go.property("type", 1)
go.property("secondary", 0)
go.property("max_distance", 40)

local function update_aim(self)
  if self.pointer then go.set_rotation(get_world_rotation(self.pointer.x, self.pointer.y)) end
  local direction = vmath.rotate(go.get_rotation(), vmath.vector3(0, 1, 0))
  Combat.aim(self.model, direction.x, direction.y)
end

function init(self)
  msg.post(".", "acquire_input_focus")
  local pos = go.get_position()
  self.model = { x = pos.x, y = pos.y, element = C.elements[self.type], secondary = C.elements[self.secondary] }
  Runtime.get().followers[go.get_id()] = self.model
  sprite.play_flipbook("#sprite", hash(self.model.element))
  label.set_text("#variant", self.model.secondary and C.names[self.model.secondary] or "")
end

function update(self, dt)
  local w = Runtime.get()
  if not w or not w.run.active then return end
  local pos, target = go.get_position(), go.get_world_position(self.parent)
  local d = vmath.length(target - pos)
  if d > self.max_distance then
    local speed = C.balance.move_speed * ((self.model.haste_until or 0) > w.time and C.balance.haste or 1)
    local delta = vmath.normalize(target - pos) * math.min(d - self.max_distance, speed * dt * math.max(1, (d - self.max_distance) / 10))
    local nx, ny = Runtime.constrain({ x = pos.x, y = pos.y }, pos.x + delta.x, pos.y + delta.y)
    pos.x, pos.y = nx, ny
    go.set_position(pos)
  end
  self.model.x, self.model.y = pos.x, pos.y
  update_aim(self)
  go.set("#sprite", "tint", vmath.vector4(1, 1, 1,
    (self.model.hidden_until or 0) > w.time and 0.15 or 1))
end

function on_input(self, action_id, action)
  local w = Runtime.get()
  if not w or not w.run.active then return end
  if action.screen_x and action.screen_y then
    self.pointer = { x = action.screen_x, y = action.screen_y }
  end
  update_aim(self)
  local element = self.model.element
  local cast = (element == "fire" and action_id == hash("touch") and action.pressed) or
    (element == "water" and action_id == hash("scroll_down")) or
    (element == "earth" and action_id == hash("scroll_up")) or
    (element == "wind" and action_id == hash("tail_action_2") and action.pressed)
  if cast then
    Skills.cast_tail(w, self.model, self.model.dx, self.model.dy)
  end
end

function final(self)
  msg.post(".", "release_input_focus")
  local w = Runtime.get()
  if w then w.followers[go.get_id()] = nil end
end
