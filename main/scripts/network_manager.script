local colyseus = require "colyseus.sdk"

go.property("server_url", 0)
local M = {}
M.client = nil
M.room = nil
M.my_session_id = nil
M.callbacks = nil

function init(self)
  self.server_url = "ws://localhost:2567"
  M.client = colyseus.Client(self.server_url)

  -- Connect to CTF room
  M.client:join_or_create("ctf_room", {}, function(err, room_instance)
    if err then
      print("Connection error:", err)
      return
    end
    M.callbacks = colyseus.callbacks(room_instance)
    M.room = room_instance
    M.my_session_id = room_instance.session_id
    print("Connected! Session ID:", M.my_session_id)

    setup_listeners(room_instance)
  end)
end

function setup_listeners(room)
  -- Player added
  M.callbacks:on_add("players", function(player, session_id)
    print("Player added:", session_id, "player number:", player.playerNumber)

    local is_local = (session_id == M.my_session_id)
    msg.post("/game_world", "spawn_player", {
      session_id = session_id,
      player_number = player.playerNumber,
      x = player.x,
      y = player.y,
      is_local = is_local
    })
    M.callbacks:listen(player, "x", function(value, previous_value)
      msg.post("/game_world", "update_from_server", {
        x = value,
        session_id = session_id
      })
    end)
    M.callbacks:listen(player, "y", function(value, previous_value)
      msg.post("/game_world", "update_from_server", {
        y = value,
        session_id = session_id
      })
    end)
    M.callbacks:listen(player, "current_animation", function(value, previous_value)
      msg.post("/game_world", "update_from_server", {
        current_animation = value,
        session_id = session_id
      })
    end)
    M.callbacks:listen(player, "last_direction", function(value, previous_value)
      msg.post("/game_world", "update_from_server", {
        last_direction = value,
        session_id = session_id
      })
    end)
    M.callbacks:listen(player, "moving", function(value, previous_value)
      msg.post("/game_world", "update_from_server", {
        moving = value,
        session_id = session_id
      })
    end)
  end)

  -- Player removed
  M.callbacks:on_remove("players", function(player, session_id)
    msg.post("/game_world", "destroy", {
      session_id = session_id })
  end)

  -- Enemy added
  M.callbacks:on_add("enemies", function(enemy, enemy_id)
    print("Enemy added:", enemy_id, enemy.enemyType)

    msg.post("/game_world", "spawn_enemy", {
      enemy_id = enemy_id,
      enemy_type = enemy.enemyType,
      x = enemy.x,
      y = enemy.y,
      state = enemy.state,
      direction = enemy.direction,
      is_frozen = enemy.isFrozen,
      is_slowed = enemy.isSlowed
    })

    -- Position listeners
    M.callbacks:listen(enemy, "x", function(value)
      msg.post("/game_world", "update_enemy", {
        enemy_id = enemy_id,
        x = value
      })
    end)

    M.callbacks:listen(enemy, "y", function(value)
      msg.post("/game_world", "update_enemy", {
        enemy_id = enemy_id,
        y = value
      })
    end)

    -- State listeners
    M.callbacks:listen(enemy, "state", function(value)
      msg.post("/game_world", "update_enemy", {
        enemy_id = enemy_id,
        state = value
      })
    end)

    M.callbacks:listen(enemy, "direction", function(value)
      msg.post("/game_world", "update_enemy", {
        enemy_id = enemy_id,
        direction = value
      })
    end)

    -- Status effect listeners
    M.callbacks:listen(enemy, "isFrozen", function(value)
      msg.post("/game_world", "update_enemy", {
        enemy_id = enemy_id,
        is_frozen = value
      })
    end)

    M.callbacks:listen(enemy, "isSlowed", function(value)
      msg.post("/game_world", "update_enemy", {
        enemy_id = enemy_id,
        is_slowed = value
      })
    end)
  end)

  -- Enemy removed
  M.callbacks:on_remove("enemies", function(enemy, enemy_id)
    print("Enemy removed:", enemy_id)
    msg.post("/game_world", "remove_enemy", {
      enemy_id = enemy_id
    })
  end)

  -- Wave state listeners
  M.callbacks:listen("wave", function(currentValue, previousValue)
    if (not previousValue or currentValue.currentWave ~= previousValue.currentWave) then
      print("Wave changed:", currentValue.currentWave)
      msg.post("/gui", "wave_changed", {
        wave_number = currentValue.currentWave
      })
    end
    if (not previousValue or currentValue.nextWaveTimer ~= previousValue.nextWaveTimer) then
      msg.post("/gui", "wave_countdown", {
        seconds = currentValue.nextWaveTimer
      })
    end
  end)


  -- Totem health listener
  M.callbacks:listen("totem", function(currentValue, previousValue)
    if (not previousValue or currentValue.health ~= previousValue.health) then
      local health_percent = currentValue.health / currentValue.maxHealth
      print("Totem health:", currentValue.health, "percent:", health_percent)
      msg.post("/gui", MESSAGES.TOTEM.SET_HEALTH, {
        health_percent = health_percent
      })
    end
  end)

  -- Team score listener
  M.callbacks:listen("score", function(currentValue, previousValue)
    if (not previousValue or currentValue.teamScore ~= previousValue.teamScore) then
      print("Team score:", currentValue.teamScore)
      msg.post("/gui", "update_team_score", {
        score = currentValue.teamScore
      })
    end
  end)
end

function send_input(message_type, data)
  if M.room then
    M.room:send(message_type, data)
  end
end

function on_message(self, message_id, message, sender)
  if message_id == hash("send_input") then
    send_input(message.type, message.data)
  end
end
