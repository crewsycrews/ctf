local Runtime = require("main.scripts.modules.runtime")
go.property("health", 100)
go.property("speed", 10)
go.property("damage", 0)
go.property("target_url", msg.url())
go.property("score_points", 1)

function init(self)
  local Combat = require("main.scripts.modules.combat")
  local w, pos = Runtime.get(), go.get_position()
  if not w or not w.run.active then go.delete(); return end
  self.model = Combat.add_enemy(w, go.get_id(), pos.x, pos.y, self.health, self.speed, self.damage)
  self.model.object = go.get_id()
end

function final(self)
  local w = Runtime.get()
  if w then w.enemies[go.get_id()] = nil end
end
