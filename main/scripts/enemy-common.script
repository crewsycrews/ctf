require("main.scripts.modules.messages")
go.property("health", 100)
go.property("speed", 10)
go.property("damage", 0)

function on_message(self, message_id, message, sender)
  if message_id == hash("collision_response") then
    if message.other_group == hash("head") then
      msg.post("/player", MESSAGES.PLAYER.TAKE_DAMAGE, { damage = self.damage })
      -- TODO explode animation
      go.delete(go.get_id())
    end

    if message.other_group == hash("totem") then
      msg.post("/totem", MESSAGES.TOTEM.TAKE_DAMAGE, { damage = self.damage })
      go.delete(go.get_id())
    end
  end
  if message_id == hash("trigger_response") then
    if (message.other_group == hash("projectiles") or message.other_group ==
        hash("ice_barrage")) and message.enter then
      local damage_done = go.get(msg.url(nil, message.other_id, 'script'),
                                 'damage')
      self.health = self.health - damage_done
    end
  end
  if self.health <= 0 then go.delete() end
end
