go.property("timeout", 1)
go.property("finishSpawnSeconds", 60)
go.property("amount", 1)

function init(self)
  timer.delay(self.timeout, true, function(self, handle, time_elapsed)
    local i
    for i = 1, self.amount do
      factory.create("#factory", go.get_position(), go.get_rotation())
    end
    i = 1
  end)
end
