go.property("horizontal", 0)
go.property("flip", 1)
local speed = 10

function init(self) speed = go.get("#enemy-common", "speed") end

function update(self, dt)
  local diff = vmath.vector3(self.flip * self.horizontal,
                             self.flip * (1 - self.horizontal), 0)
  local new_position = go.get_position() + diff * speed * dt
  go.set_position(new_position)
  sprite.set_hflip("#sprite", self.flip > 0)
end

function on_message(self, message_id, message, sender)
  if message_id == hash("collision_response") then
    if message.other_group == hash("obstacles") then
      self.flip = self.flip * -1
    end
  end
end
