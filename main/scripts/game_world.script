function init(self)
  self.player_instances = {}
  self.enemy_instances = {}
  print("Game world initialized")
end

function on_message(self, message_id, message, sender)
  if message_id == hash("spawn_player") then
    print("Spawning player:", message.session_id, "is_local:", message.is_local, "position: ", message.x, message.y)

    local pos = vmath.vector3(message.x, message.y, 0)
    -- Spawn player using factory
    local player_id = factory.create("#player_factory", pos, nil, {
      is_local = message.is_local
    }, 1)

    self.player_instances[message.session_id] = player_id
    -- Set up local player
    if message.is_local then
      msg.post(player_id, "set_local_player", {
        session_id = message.session_id
      })
    end
  end

  if message_id == hash("destroy_player") then
    local player_id = self.player_instances[message.session_id]
    if player_id then
      msg.post(player_id, "destroy")
      self.player_instances[message.session_id] = nil
    end
  end

  if message_id == hash("update_from_server") then
    local player_id = self.player_instances[message.session_id]
    msg.post(player_id, "update_from_server", message)
  end

  -- Enemy spawning
  if message_id == hash("spawn_enemy") then
  print("Spawning enemy:", message.enemy_id, message.enemy_type, "at", message.x, message.y)

    local pos = vmath.vector3(message.x, message.y, 0)

    -- Determine which factory to use based on enemy_type
    local factory_url = "#" .. message.enemy_type .. "-factory"
    local enemy_obj_id = factory.create(factory_url, pos)

    self.enemy_instances[message.enemy_id] = enemy_obj_id

    -- Initialize enemy with network mode
    msg.post(enemy_obj_id, "init_network_enemy", {
      enemy_id = message.enemy_id,
      enemy_type = message.enemy_type,
      state = message.state,
      direction = message.direction,
      is_frozen = message.is_frozen,
      is_slowed = message.is_slowed
    })
  end

  -- Enemy updates
  if message_id == hash("update_enemy") then
    local enemy_obj_id = self.enemy_instances[message.enemy_id]
    if enemy_obj_id then
      msg.post(enemy_obj_id, "update_from_server", message)
    end
  end

  -- Enemy removal
  if message_id == hash("remove_enemy") then
    local enemy_obj_id = self.enemy_instances[message.enemy_id]
    if enemy_obj_id then
      msg.post(enemy_obj_id, "die")
      self.enemy_instances[message.enemy_id] = nil
    end
  end

  -- Skill messages - forward to owner's player (player will forward to orb)
  if message_id == hash("skill_activated") then
    local player_id = self.player_instances[message.session_id]
    if player_id then
      msg.post(player_id, "skill_activated", message)
    end
  end

  if message_id == hash("spawn_active_skill") then
    local player_id = self.player_instances[message.owner_id]
    if player_id then
      msg.post(player_id, "spawn_active_skill", message)
    end
  end

  if message_id == hash("update_active_skill") then
    -- Broadcast to all players - each player/orb will check if it owns this skill
    for _, player_id in pairs(self.player_instances) do
      msg.post(player_id, "update_active_skill", message)
    end
  end

  if message_id == hash("remove_active_skill") then
    -- Broadcast to all players - each player/orb will check if it owns this skill
    for _, player_id in pairs(self.player_instances) do
      msg.post(player_id, "remove_active_skill", message)
    end
  end
end
