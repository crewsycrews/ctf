require("main.scripts.modules.constants")
local Session = require("main.scripts.modules.session")
local proxies = { menu = "/loader#menu", garden = "/loader#garden",
  game_over = "/loader#game_over", [1] = "/loader#level1" }
function init(self)
  -- Seed once per application launch, never when starting a level or rolling loot.
  math.randomseed(os.time())
  -- The proxy owner must be in the input stack to forward input to loaded scenes.
  msg.post(".", "acquire_input_focus")
  self.current, self.target, self.busy = nil, nil, false
  Session.load()
end
function final(self)
  msg.post(".", "release_input_focus")
end
function on_message(self, message_id, message, sender)
  if message_id == hash("load_level") and not self.busy then
    if not proxies[message.level] or message.level == self.current then return end
    if message.level == 1 and (not Session.run or not Session.run.active) then return end
    self.target, self.busy = message.level, true
    if self.current then
      msg.post(proxies[self.current], "disable")
      msg.post(proxies[self.current], "final")
      msg.post(proxies[self.current], "unload")
    else msg.post(proxies[self.target], "load") end
  elseif message_id == hash("proxy_unloaded") and self.busy then
    msg.post(proxies[self.target], "load")
  elseif message_id == hash("proxy_loaded") and self.busy then
    self.current, self.busy = self.target, false
    msg.post(sender, "init")
    msg.post(sender, "enable")
  end
end
