---@class Head
---@field moving bool
---@field dashing bool
---@field jumping bool
---@field max_health number Set via go.property
---@field current_health number
---@field input quaternion|vector3|vector4
---@field dir quaternion|vector3|vector4
---@field speed number
---@field followers table
---@field followers_amount number
---@field health number
---@field buffs table
---@field dash_on_cooldown bool
---@field backward_dash_on_cooldown bool
---@field ice_barrage_on_cooldown bool
---@field ice_barrage_active bool
---@field thunderclap_on_cooldown bool
---@field thunderclap_active bool
---@field windwalk_on_cooldown bool
---@field windwalk_active bool
---@field score number
---@field pointer quaternion|vector3|vector4
---@field current_animation string
---@field last_direction string Track last movement direction for idle animations
---@field buff_visual_target string
---@field orb_id hash The floating orb that casts spells
go.property('speed', 200)
go.property("max_health", 300)

require("main.scripts.common.get_world_rotation")
local camera = require("orthographic.camera")
local skills = require("main.scripts.modules.skills")


---@param self Head
function init(self)
  msg.post(".", "acquire_input_focus")
  camera.follow(nil, go.get_id())

  self.moving = false
  self.dashing = false
  self.input = vmath.vector3(0, 0, 0)
  self.dir = vmath.vector3(1, 0, 0)
  self.score = 0
  self.pointer = vmath.vector3(0, 0, 0)
  self.buffs = {}
  self.buff_visual_target = "#sprite"
  self.current_animation = "idle_south"
  self.last_direction = "south"

  self.current_health = self.max_health
  -- followersManipulator.spawn_followers(self)

  -- Spawn floating orb and store reference
  self.orb_id = factory.create("#floating-orb-factory")
  msg.post(self.orb_id, "set_player", { player_id = go.get_id() })
end

---@param self Head
function final(self) msg.post(".", "release_input_focus") end

---@param self Head
function update(self, dt)
  -- Handle dashing or normal movement
  if self.dashing or self.moving then
    local target_position = go.get_position()
    target_position = target_position + self.dir * self.speed * dt
    go.set_position(target_position)
  end

  -- If not moving, switch to idle animation
  if not self.moving then
    local idle_animation = "idle_" .. self.last_direction
    if idle_animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(idle_animation) })
      self.current_animation = idle_animation
    end
  end

  self.input.x = 0
  self.input.y = 0
  self.dir = vmath.normalize(self.dir)
  self.moving = false

  -- checkRotation(self)

  if self.current_health <= 0 then
    msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, { level = "game_over" })
  end
end

---@param self Head
function on_input(self, action_id, action)
  -- Handle movement input
  if action_id == hash("up") then
    self.input.y = 1
    self.moving = true
  elseif action_id == hash("down") then
    self.input.y = -1
    self.moving = true
  elseif action_id == hash("left") then
    self.input.x = -1
    self.moving = true
  elseif action_id == hash("right") then
    self.input.x = 1
    self.moving = true
  elseif action_id == hash("head_action_1") and action.pressed then
    skills.dash(self)
  elseif action_id == hash("head_action_2") and action.pressed and
      not self.jumping then
    skills.jump(self)
  elseif action_id == hash("head_action_3") and action.pressed then
    skills.backward_dash(self)
  end

  -- Update animation based on movement state
  if self.moving and vmath.length(self.input) > 0 then
    self.dir = vmath.normalize(self.input)

    -- Determine which animation to play based on direction
    local animation = "south" -- default
    if math.abs(self.dir.x) > math.abs(self.dir.y) then
      -- Horizontal movement is dominant
      if self.dir.x > 0 then
        animation = "east"
      else
        animation = "west"
      end
    else
      -- Vertical movement is dominant
      if self.dir.y > 0 then
        animation = "north"
      else
        animation = "south"
      end
    end

    -- Store the last direction for idle animations
    self.last_direction = animation

    -- Only change animation if it's different from current
    if animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(animation) })
      self.current_animation = animation
    end
  end

  -- Delegate attacking spells to the orb
  if action_id == hash("scroll_down") then
    msg.post(self.orb_id, "cast_ice_barrage")
  end
  if action_id == hash("touch") then
    msg.post(self.orb_id, "cast_fireball")
  end
  if action_id == hash("scroll_up") then
    msg.post(self.orb_id, "cast_thunderclap")
  end
  -- Windwalk stays on player as it's a defensive buff
  if action_id == hash("tail_action_2") then skills.windwalk(self) end
  if not action_id then
    self.pointer.x = action.x
    self.pointer.y = action.y
  end
end

---@param self Head
function on_message(self, message_id, message)
  if message_id == hash(MESSAGES.PLAYER.TAKE_DAMAGE) then
    local damage = message.damage
    self.current_health = self.current_health - damage
    -- max health(100 number) is a subject to initialize at load time on level init. So we'll need to change next line later
    msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
      { health_percent = self.current_health / self.max_health })

    if self.current_health <= 0 then
      msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL,
        { level = "game_over" })
    end
  end
end
