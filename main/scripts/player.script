---@class Head
---@field moving bool
---@field dashing bool
---@field jumping bool
---@field max_health number Set via go.property
---@field current_health number
---@field input quaternion|vector3|vector4
---@field dir quaternion|vector3|vector4
---@field speed number
---@field followers table
---@field followers_amount number
---@field health number
---@field buffs table
---@field dash_on_cooldown bool
---@field backward_dash_on_cooldown bool
---@field ice_barrage_on_cooldown bool
---@field ice_barrage_active bool
---@field thunderclap_on_cooldown bool
---@field thunderclap_active bool
---@field windwalk_on_cooldown bool
---@field windwalk_active bool
---@field score number
---@field pointer quaternion|vector3|vector4
---@field current_animation string
---@field last_direction string Track last movement direction for idle animations
---@field buff_visual_target string
---@field orb_id hash The floating orb that casts spells
---@field session_id string
---@field is_local bool
---@field server_position vector3 Last known server position
---@field reconciliation_speed number How fast to lerp to server position
---@field active_skill_instances table Maps skill_id to game_object_id for active skills
go.property('speed', 200)
go.property("max_health", 300)
go.property("is_local", false)

require("main.scripts.common.get_world_rotation")
local camera = require("orthographic.camera")
local skills = require("main.scripts.modules.skills")


---@param self Head
function init(self)
  -- Input focus and camera will be set up for local player only

  self.moving = false
  self.dashing = false
  self.input = vmath.vector3(0, 0, 0)
  self.dir = vmath.vector3(1, 0, 0)
  self.score = 0
  self.pointer = vmath.vector3(0, 0, 0)
  self.buffs = {}
  self.buff_visual_target = "sprite#sprite"
  self.current_animation = "idle_south"
  self.last_direction = "south"
  self.session_id = ""
  self.server_position = nil
  self.reconciliation_speed = 10 -- How fast to interpolate to server position

  self.current_health = self.max_health
  -- followersManipulator.spawn_followers(self)

  -- Spawn floating orb and store reference
  self.orb_id = factory.create("#floating-orb-factory")
  msg.post(self.orb_id, "set_player", { player_id = go.get_id(), is_local = self.is_local })

  -- Track active skill visual game objects (skill_id -> game_object_id)
  self.active_skill_instances = {}
end

---@param self Head
function final(self) msg.post(".", "release_input_focus") end

---@param self Head
function update(self, dt)
  -- Local player: predict movement locally for responsiveness
  if self.is_local and self.moving then
    local pos = go.get_position()
    pos = pos + self.dir * self.speed * dt
    go.set_position(pos)


    msg.post("/network_manager", "send_input", {
      type = "player_update",
      data = {
        x = go.get_position().x,
        y = go.get_position().y,
      }
    })
  end

  -- Server reconciliation: smoothly correct position if drifting from server
  if self.is_local and self.server_position then
    local current_pos = go.get_position()
    local dx = self.server_position.x - current_pos.x
    local dy = self.server_position.y - current_pos.y
    local distance_sq = dx * dx + dy * dy

    -- Only reconcile if drift is significant (more than 5 pixels)
    if distance_sq > 25 then
      -- Smoothly interpolate towards server position
      local correction_amount = self.reconciliation_speed * dt
      local new_pos = vmath.vector3(
        current_pos.x + dx * correction_amount,
        current_pos.y + dy * correction_amount,
        0
      )
      go.set_position(new_pos)
    end
  end

  -- If not moving, switch to idle animation
  if not self.moving then
    local idle_animation = "idle_" .. self.last_direction
    if idle_animation ~= self.current_animation and self.is_local then
      msg.post("#sprite", "play_animation", { id = hash(idle_animation) })
      self.current_animation = idle_animation
      msg.post("/network_manager", "send_input", {
        type = "player_update",
        data = {
          current_animation = self.current_animation
        }
      })
    end
  end
  -- msg.post("/network_manager", "send_input", {
  --   type = "player_update",
  --   data = {
  --     moving = self.moving
  --   }
  -- })

  -- Reset input state each frame
  self.input.x = 0
  self.input.y = 0
  self.dir = vmath.normalize(self.dir)
  self.moving = false

  -- Check health
  if self.current_health <= 0 then
    msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, { level = "game_over" })
  end
end

---@param self Head
function on_input(self, action_id, action)
  -- Only process input for local player
  if not self.is_local then return end

  -- Handle movement input
  local input_x, input_y = 0, 0
  local moving = false
  local animation = nil

  if action_id == hash("up") then
    input_y = 1
    moving = true
  elseif action_id == hash("down") then
    input_y = -1
    moving = true
  elseif action_id == hash("left") then
    input_x = -1
    moving = true
  elseif action_id == hash("right") then
    input_x = 1
    moving = true
  end

  -- Store input for local processing
  if moving then
    self.input.x = input_x
    self.input.y = input_y
    self.moving = true

    -- Normalize for diagonal movement
    -- if input_x ~= 0 and input_y ~= 0 then
    --   local length = math.sqrt(input_x * input_x + input_y * input_y)
    --   input_x = input_x / length
    --   input_y = input_y / length
    -- end

    self.dir = vmath.normalize(self.input)

    -- Determine animation based on direction
    if math.abs(self.dir.x) > math.abs(self.dir.y) then
      animation = (self.dir.x > 0) and "east" or "west"
    else
      animation = (self.dir.y > 0) and "north" or "south"
    end

    self.last_direction = animation
    if animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(animation) })
      self.current_animation = animation
      msg.post("/network_manager", "send_input", {
        type = "player_update",
        data = {
          current_animation = self.current_animation,
          last_direction = self.last_direction
        }
      })
    end
  end

  -- Skills (Phase 2)
  if action_id == hash("head_action_1") and action.pressed then
    skills.dash(self)          -- Will be handled by server in Phase 2
  elseif action_id == hash("head_action_2") and action.pressed then
    skills.jump(self)          -- Will be handled by server in Phase 2
  elseif action_id == hash("head_action_3") and action.pressed then
    skills.backward_dash(self) -- Will be handled by server in Phase 2
  end

  -- Orb spells (Phase 2)
  if action_id == hash("scroll_down") and action.pressed then
    msg.post(self.orb_id, "cast_ice_barrage")
  end
  if action_id == hash("touch") and action.pressed then
    msg.post(self.orb_id, "cast_fireball")
  end
  if action_id == hash("scroll_up") and action.pressed then
    msg.post(self.orb_id, "cast_thunderclap")
  end

  -- Mouse tracking
  if not action_id then
    self.pointer.x = action.x
    self.pointer.y = action.y
  end
end

---@param self Head
function on_message(self, message_id, message)
  if message_id == hash("set_local_player") then
    -- Mark as local player
    self.is_local = true
    self.session_id = message.session_id
    msg.post(".", "acquire_input_focus")

    -- Camera follows local player
    local camera = require("orthographic.camera")
    camera.follow(nil, go.get_id())

    print("Local player set up:", self.session_id)
  elseif message_id == hash("player_update_from_server") then
    -- Update server position for reconciliation
    if message.x or message.y then
      local current_pos = go.get_position()
      local server_x = message.x or current_pos.x
      local server_y = message.y or current_pos.y

      if not self.server_position then
        self.server_position = vmath.vector3(server_x, server_y, 0)
      else
        self.server_position.x = server_x
        self.server_position.y = server_y
      end

      if not self.is_local then
        go.set_position(self.server_position)
      end
    end
    if not self.is_local then
      if message.current_animation and message.current_animation ~= self.current_animation then
        self.current_animation = message.current_animation
        msg.post("#sprite", "play_animation", { id = hash(message.current_animation) })
      end
      if message.moving then
        self.moving = message.moving
      end
      if message.orbX or message.orbY then
        local current_orb_pos = go.get_position(self.orb_id)
        local orb_server_x = message.orbX or current_orb_pos.x
        local orb_server_y = message.orbY or current_orb_pos.y
        local orb_server_position = vmath.vector3(orb_server_x, orb_server_y, 0)

        go.set_position(orb_server_position, self.orb_id)
      end
    end
  elseif message_id == hash("destroy") then
    -- Remove this player
    go.delete()
  elseif message_id == hash(MESSAGES.PLAYER.TAKE_DAMAGE) then
    local damage = message.damage
    self.current_health = self.current_health - damage
    msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
      { health_percent = self.current_health / self.max_health })

    if self.current_health <= 0 then
      msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL,
        { level = "game_over" })
    end
  elseif message_id == hash("skill_activated") then
    -- Visual feedback for skill activation (camera shake, particles, sound)
    -- This fires immediately when skill is used, before projectile spawns
    print("Skill activated:", message.skill_type, "by session:", message.session_id)

    -- TODO: Add visual/audio feedback based on skill_type
    -- - Camera shake for impact skills
    -- - Sound effects
    -- - Flash effects
  elseif message_id == hash("spawn_active_skill") then
    -- Spawn visual representation of server-controlled skill
    -- Only spawn if this player owns the skill
    if message.owner_id == self.session_id then
      print("Spawning active skill:", message.skill_id, message.skill_type)

      local pos = vmath.vector3(message.x, message.y, 0)
      local rotation = vmath.quat_rotation_z(message.direction)

      -- Determine factory based on skill_type
      local factory_id = "#" .. message.skill_type:gsub("_", "-") .. "-spell-factory"

      -- Create the skill visual game object
      local skill_obj = factory.create(factory_id, pos, rotation)

      -- Store reference for updates/removal
      self.active_skill_instances[message.skill_id] = skill_obj

      print("Created skill visual at", pos, "with factory", factory_id)
    end
  elseif message_id == hash("update_active_skill") then
    -- Update position of active skill (for projectiles moving or parent-locked AoE)
    local skill_obj = self.active_skill_instances[message.skill_id]
    if skill_obj then
      local new_pos = go.get_position(skill_obj)
      if message.x then new_pos.x = message.x end
      if message.y then new_pos.y = message.y end
      go.set_position(new_pos, skill_obj)
    end
  elseif message_id == hash("remove_active_skill") then
    -- Remove active skill visual (projectile hit or duration expired)
    local skill_obj = self.active_skill_instances[message.skill_id]
    if skill_obj then
      go.delete(skill_obj)
      self.active_skill_instances[message.skill_id] = nil
      print("Removed active skill:", message.skill_id)
    end
  end
end
