---@class Head
---@field moving bool
---@field dashing bool
---@field jumping bool
---@field input quaternion|vector3|vector4
---@field dir quaternion|vector3|vector4
---@field speed number
---@field followers table
---@field followers_amount number
---@field buffs table
---@field dash_on_cooldown bool
---@field backward_dash_on_cooldown bool
---@field fireball_on_cooldown bool
---@field ice_barrage_on_cooldown bool
---@field ice_barrage_active bool
---@field thunderclap_on_cooldown bool
---@field thunderclap_active bool
---@field windwalk_on_cooldown bool
---@field windwalk_active bool
---@field score number
---@field pointer quaternion|vector3|vector4
---@field mouse_screen_pos vector3 Current mouse position on screen
---@field mouse_world_pos vector3 Current mouse position in world
---@field current_animation string
---@field last_direction string Track last movement direction for idle animations
---@field buff_visual_target string
---@field m20_stats table M20 stats (STR, DEX, MIND, HP, AC, etc.)
---@field m20_skills table M20 skills (physical, subterfuge, knowledge, communication)
---@field signature_spells table Signature spells (reduced HP cost)
---@field pending_level_up bool Whether player is waiting to select stat on level-up
go.property('speed', 200)

require("main.scripts.common.get_world_rotation")
local camera = require("orthographic.camera")
local skills = require("main.scripts.modules.skills")

-- M20 System Modules
local attrs = require("main.scripts.modules.m20_attributes")
local m20_skills = require("main.scripts.modules.m20_skills")
local classes = require("main.scripts.modules.m20_classes")
local progression = require("main.scripts.modules.m20_progression")
local magic = require("main.scripts.modules.m20_magic")


---@param self Head
function init(self)
  msg.post(".", "acquire_input_focus")
  camera.follow(nil, go.get_id())

  self.moving = false
  self.dashing = false
  self.input = vmath.vector3(0, 0, 0)
  self.dir = vmath.vector3(1, 0, 0)
  self.score = 0
  self.pointer = vmath.vector3(0, 0, 0)
  self.mouse_screen_pos = vmath.vector3(0, 0, 0)
  self.mouse_world_pos = vmath.vector3(0, 0, 0)
  self.buffs = {}
  self.buff_visual_target = "#sprite"
  self.current_animation = "idle_south"
  self.last_direction = "south"

  -- Initialize spell cooldown states
  self.fireball_on_cooldown = false
  self.ice_barrage_on_cooldown = false
  self.ice_barrage_active = false
  self.thunderclap_on_cooldown = false
  self.thunderclap_active = false
  self.windwalk_on_cooldown = false
  self.windwalk_active = false

  -- followersManipulator.spawn_followers(self)

  -- Initialize M20 stats (Fighter class, Human race by default)
  -- TODO: Add class/race selection UI in future milestone
  attrs.initialize_entity(self, "fighter", "human", true)
  m20_skills.initialize_skills(self, "fighter", "human")
  classes.apply_class_features(self, "fighter")
  magic.initialize_signature_spells(self)

  print(string.format("[M20] Player initialized: Level %d %s %s",
    self.m20_stats.level,
    self.m20_stats.race:sub(1, 1):upper() .. self.m20_stats.race:sub(2),
    self.m20_stats.class:sub(1, 1):upper() .. self.m20_stats.class:sub(2)
  ))
  print(string.format("[M20] Stats - STR:%d DEX:%d MIND:%d | HP:%d/%d AC:%d",
    self.m20_stats.STR, self.m20_stats.DEX, self.m20_stats.MIND,
    self.m20_stats.hp_current, self.m20_stats.hp_max, self.m20_stats.ac
  ))
end

---@param self Head
function final(self) msg.post(".", "release_input_focus") end

---@param self Head
function update(self, dt)
  -- Convert screen coordinates to world coordinates for spell targeting
  self.mouse_world_pos = camera.screen_to_world(go.get_id("/camera"), self.mouse_screen_pos)

  -- Handle dashing or normal movement
  if self.dashing or self.moving then
    local target_position = go.get_position()
    target_position = target_position + self.dir * self.speed * dt
    go.set_position(target_position)
  end

  -- If not moving, switch to idle animation
  if not self.moving then
    local idle_animation = "idle_" .. self.last_direction
    if idle_animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(idle_animation) })
      self.current_animation = idle_animation
    end
  end

  self.input.x = 0
  self.input.y = 0
  self.dir = vmath.normalize(self.dir)
  self.moving = false

  if self.m20_stats.hp_current <= 0 then
    msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, { level = "game_over" })
  end
end

---@param self Head
function on_input(self, action_id, action)
  -- Handle movement input
  if action_id == hash("up") then
    self.input.y = 1
    self.moving = true
  elseif action_id == hash("down") then
    self.input.y = -1
    self.moving = true
  elseif action_id == hash("left") then
    self.input.x = -1
    self.moving = true
  elseif action_id == hash("right") then
    self.input.x = 1
    self.moving = true
  elseif action_id == hash("head_action_1") and action.pressed then
    skills.dash(self)
  elseif action_id == hash("head_action_2") and action.pressed and
      not self.jumping then
    skills.jump(self)
  elseif action_id == hash("head_action_3") and action.pressed then
    skills.backward_dash(self)
  end

  -- Update animation based on movement state
  if self.moving and vmath.length(self.input) > 0 then
    self.dir = vmath.normalize(self.input)

    -- Determine which animation to play based on direction
    local animation = "south" -- default
    if math.abs(self.dir.x) > math.abs(self.dir.y) then
      -- Horizontal movement is dominant
      if self.dir.x > 0 then
        animation = "east"
      else
        animation = "west"
      end
    else
      -- Vertical movement is dominant
      if self.dir.y > 0 then
        animation = "north"
      else
        animation = "south"
      end
    end

    -- Store the last direction for idle animations
    self.last_direction = animation

    -- Only change animation if it's different from current
    if animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(animation) })
      self.current_animation = animation
    end
  end

  -- Cast spells directly from player
  if action_id == hash("scroll_down") then
    skills.ice_barrage(self)
  end
  if action_id == hash("touch") then
    skills.fireball(self)
  end
  if action_id == hash("scroll_up") then
    skills.thunderclap(self)
  end
  if action_id == hash("tail_action_2") then
    skills.windwalk(self)
  end

  -- Track mouse position for spell targeting
  if not action_id then
    self.pointer.x = action.x
    self.pointer.y = action.y
    self.mouse_screen_pos.x = action.x
    self.mouse_screen_pos.y = action.y
  end
end

---@param self Head
function on_message(self, message_id, message)
  if message_id == hash("get_mouse_screen_pos") then
    -- Respond to spell requests for mouse screen position
    msg.post(message.requester, "mouse_screen_pos_response", { mouse_screen_pos = self.mouse_screen_pos })
  elseif message_id == hash("set_class") then
    -- Re-initialize M20 stats with the selected class and race
    local selected_class = message.class or "fighter"
    local selected_race = message.race or "human"

    print(string.format("[M20] Player class selection received: %s %s",
      selected_race:sub(1, 1):upper() .. selected_race:sub(2),
      selected_class:sub(1, 1):upper() .. selected_class:sub(2)
    ))

    attrs.initialize_entity(self, selected_class, selected_race, true)
    m20_skills.initialize_skills(self, selected_class, selected_race)
    classes.apply_class_features(self, selected_class)
    magic.initialize_signature_spells(self)

    -- Update GUI with new HP
    msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
      { health_percent = self.m20_stats.hp_current / self.m20_stats.hp_max })

    print(string.format("[M20] Stats - STR:%d DEX:%d MIND:%d | HP:%d/%d AC:%d",
      self.m20_stats.STR, self.m20_stats.DEX, self.m20_stats.MIND,
      self.m20_stats.hp_current, self.m20_stats.hp_max, self.m20_stats.ac
    ))
  elseif message_id == hash(MESSAGES.PLAYER.TAKE_DAMAGE) then
    local damage = message.damage

    -- Apply damage to M20 stats (source of truth)
    attrs.take_damage(self, damage)

    -- Update GUI
    msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
      { health_percent = self.m20_stats.hp_current / self.m20_stats.hp_max })

    if self.m20_stats.hp_current <= 0 then
      msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL,
        { level = "game_over" })
    end
  elseif message_id == hash(MESSAGES.M20.AWARD_XP) then
    -- Award XP from enemy kills
    local xp_amount = message.xp or 0
    progression.award_xp(self, xp_amount)

    print(string.format("[M20] +%d XP! Total: %d/%d (Level %d)",
      xp_amount,
      self.m20_stats.xp,
      self.m20_stats.xp_to_next_level,
      self.m20_stats.level
    ))

    -- Check for level-up
    if progression.check_level_up(self) then
      -- Check if this is a stat-selection level (3, 6, 9, etc.)
      local next_level = self.m20_stats.level + 1
      local needs_stat_choice = (next_level % 3 == 0)

      if needs_stat_choice then
        -- Show stat selection UI and wait for player choice
        print(string.format("[M20] Level %d reached! Showing stat selection UI", next_level))
        msg.post("/gui/gui#stat_selection", "show_stat_selection", { level = next_level })
        self.pending_level_up = true
      else
        -- Auto-level-up for non-stat levels
        local result = progression.level_up(self, nil)

        -- Apply class-specific bonuses
        classes.apply_class_features(self, self.m20_stats.class)

        -- Update GUI
        msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
          { health_percent = self.m20_stats.hp_current / self.m20_stats.hp_max })

        print(string.format("[M20] LEVEL UP! Now level %d (+%d HP, total: %d/%d)",
          result.new_level,
          result.hp_gained,
          self.m20_stats.hp_current,
          self.m20_stats.hp_max
        ))
      end
    end
  elseif message_id == hash("stat_selected") then
    -- Handle stat selection response from GUI
    local selected_stat = message.stat
    print(string.format("[M20] Stat selected: %s", selected_stat))

    if self.pending_level_up then
      -- Complete the level-up with the chosen stat
      local result = progression.level_up(self, selected_stat)

      -- Apply class-specific bonuses
      classes.apply_class_features(self, self.m20_stats.class)

      -- Update GUI
      msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
        { health_percent = self.m20_stats.hp_current / self.m20_stats.hp_max })

      print(string.format("[M20] LEVEL UP! Now level %d (+%d HP, total: %d/%d)",
        result.new_level,
        result.hp_gained,
        self.m20_stats.hp_current,
        self.m20_stats.hp_max
      ))

      if result.stat_increased then
        print(string.format("[M20] %s increased to %d!",
          result.stat_increased,
          self.m20_stats[result.stat_increased]
        ))
      end

      self.pending_level_up = false
    end
  end
end
