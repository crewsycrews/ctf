local C = require("main.scripts.modules.catalog")
local Combat = require("main.scripts.modules.combat")
local Runtime = require("main.scripts.modules.runtime")
local Skills = require("main.scripts.modules.skills")
local Followers = require("main.scripts.modules.followers")
local camera = require("orthographic.camera")
go.property("speed", 200)
go.property("max_health", 100)

function init(self)
  msg.post(".", "acquire_input_focus")
  camera.follow(nil, go.get_id())
  self.dir, self.keys, self.ready = vmath.vector3(1, 0, 0), {}, {}
  self.followers = {}
  local w = Runtime.get()
  local pos = go.get_position()
  w.head.x, w.head.y = pos.x, pos.y
  Followers.spawn_followers(self)
end

local function maneuver(self, action)
  local w = Runtime.get()
  if self.movement then return end
  self.movement = Skills.start_head(w, action, self.ready, self.dir)
  if not self.movement then return end
  if action == "jump" then Followers.animate_jump(self) end
end

function update(self, dt)
  local w = Runtime.get()
  if not w or not w.run.active then return end
  local input = vmath.vector3((self.keys.right and 1 or 0) - (self.keys.left and 1 or 0),
    (self.keys.up and 1 or 0) - (self.keys.down and 1 or 0), 0)
  if vmath.length(input) > 0 then
    self.dir = vmath.normalize(input)
    msg.post("sprite", "look_at", { dir = self.dir })
  end
  local pos = go.get_position()
  local x, y = pos.x, pos.y
  local m = self.movement
  local speed, direction = self.speed, self.dir
  if m and m.action ~= "jump" then
    speed = C.balance.dash_distance / m.duration
    direction = vmath.vector3(m.direction.x, m.direction.y, 0) * (m.action == "backward_dash" and -1 or 1)
  end
  local step = dt
  if m then step = math.min(dt, m.duration - m.elapsed) end
  local nx, ny = Runtime.constrain({ x = x, y = y }, x + direction.x * speed * step, y + direction.y * speed * step)
  go.set_position(vmath.vector3(nx, ny, pos.z))
  w.head.x, w.head.y = nx, ny
  if m then
    m.elapsed = m.elapsed + step
    if m.action == "dash" then Combat.head_trace(w, m.group, x, y, nx, ny) end
    if m.action == "jump" then go.set_scale(1 + math.sin(math.pi * m.elapsed / m.duration)) end
    if m.elapsed >= m.duration then
      if m.action == "jump" then Combat.head_land(w, m.group, nx, ny); go.set_scale(1) end
      self.movement = nil
    end
  end
  go.set("sprite#sprite", "tint", Runtime.color(w.head.shield > 0 and "earth" or ""))
end

function on_input(self, action_id, action)
  local w = Runtime.get()
  if not w or not w.run.active then return end
  for _, key in ipairs({ "up", "down", "left", "right" }) do
    if action_id == hash(key) then self.keys[key] = not action.released end
  end
  if action.pressed then
    if action_id == hash("head_action_1") then maneuver(self, "dash")
    elseif action_id == hash("head_action_2") then maneuver(self, "jump")
    elseif action_id == hash("head_action_3") then maneuver(self, "backward_dash")
    end
  end
end

function final(self) msg.post(".", "release_input_focus") end
