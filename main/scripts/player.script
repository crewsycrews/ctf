---@class Head
---@field moving bool
---@field dashing bool
---@field jumping bool
---@field max_health number Set via go.property
---@field current_health number
---@field input quaternion|vector3|vector4
---@field dir quaternion|vector3|vector4
---@field speed number
---@field followers table
---@field followers_amount number
---@field health number
---@field buffs table
---@field dash_on_cooldown bool
---@field backward_dash_on_cooldown bool
---@field ice_barrage_on_cooldown bool
---@field ice_barrage_active bool
---@field thunderclap_on_cooldown bool
---@field thunderclap_active bool
---@field windwalk_on_cooldown bool
---@field windwalk_active bool
---@field score number
---@field pointer quaternion|vector3|vector4
---@field current_animation string
---@field last_direction string Track last movement direction for idle animations
---@field buff_visual_target string
---@field orb_id hash The floating orb that casts spells
---@field session_id string
go.property('speed', 200)
go.property("max_health", 300)
go.property("is_local", false)

require("main.scripts.common.get_world_rotation")
local camera = require("orthographic.camera")
local skills = require("main.scripts.modules.skills")


---@param self Head
function init(self)
  -- Input focus and camera will be set up for local player only

  self.moving = false
  self.dashing = false
  self.input = vmath.vector3(0, 0, 0)
  self.dir = vmath.vector3(1, 0, 0)
  self.score = 0
  self.pointer = vmath.vector3(0, 0, 0)
  self.buffs = {}
  self.buff_visual_target = "sprite#sprite"
  self.current_animation = "idle_south"
  self.last_direction = "south"
  self.session_id = ""

  self.current_health = self.max_health
  -- followersManipulator.spawn_followers(self)

  -- Spawn floating orb and store reference
  self.orb_id = factory.create("#floating-orb-factory")
  msg.post(self.orb_id, "set_player", { player_id = go.get_id() })
end

---@param self Head
function final(self) msg.post(".", "release_input_focus") end

---@param self Head
function update(self, dt)
  -- Server controls position now, no direct position updates

  -- If not moving, switch to idle animation
  if not self.moving then
    local idle_animation = "idle_" .. self.last_direction
    if idle_animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(idle_animation) })
      self.current_animation = idle_animation
    end
  end

  -- Reset input state each frame
  self.input.x = 0
  self.input.y = 0
  self.moving = false

  -- Check health
  if self.current_health <= 0 then
    msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL, { level = "game_over" })
  end
end

---@param self Head
function on_input(self, action_id, action)
  -- Only process input for local player
  if not self.is_local then return end

  -- Handle movement input
  local input_x, input_y = 0, 0
  local moving = false
  local animation = nil

  if action_id == hash("up") then
    input_y = 1
    moving = true
  elseif action_id == hash("down") then
    input_y = -1
    moving = true
  elseif action_id == hash("left") then
    input_x = -1
    moving = true
  elseif action_id == hash("right") then
    input_x = 1
    moving = true
  end

  -- Store input for local processing
  if moving then
    self.input.x = input_x
    self.input.y = input_y
    self.moving = true

    -- Normalize for diagonal movement
    if input_x ~= 0 and input_y ~= 0 then
      local length = math.sqrt(input_x * input_x + input_y * input_y)
      input_x = input_x / length
      input_y = input_y / length
    end

    self.dir = vmath.normalize(vmath.vector3(input_x, input_y, 0))

    -- Determine animation based on direction
    if math.abs(self.dir.x) > math.abs(self.dir.y) then
      animation = (self.dir.x > 0) and "east" or "west"
    else
      animation = (self.dir.y > 0) and "north" or "south"
    end

    self.last_direction = animation

    -- Send input to server
    msg.post("/network_manager", "send_input", {
      type = "player_input",
      data = {
        x = input_x,
        y = input_y,
        moving = moving,
        animation = animation,
        lastDirection = self.last_direction
      }
    })
  end

  -- Skills (Phase 2)
  if action_id == hash("head_action_1") and action.pressed then
    -- skills.dash(self) -- Will be handled by server in Phase 2
  elseif action_id == hash("head_action_2") and action.pressed then
    -- skills.jump(self) -- Will be handled by server in Phase 2
  elseif action_id == hash("head_action_3") and action.pressed then
    -- skills.backward_dash(self) -- Will be handled by server in Phase 2
  end

  -- Orb spells (Phase 2)
  if action_id == hash("scroll_down") then
    -- msg.post(self.orb_id, "cast_ice_barrage")
  end
  if action_id == hash("touch") then
    -- msg.post(self.orb_id, "cast_fireball")
  end
  if action_id == hash("scroll_up") then
    -- msg.post(self.orb_id, "cast_thunderclap")
  end

  -- Mouse tracking
  if not action_id then
    self.pointer.x = action.x
    self.pointer.y = action.y
  end
end

---@param self Head
function on_message(self, message_id, message)
  if message_id == hash("set_local_player") then
    -- Mark as local player
    self.is_local = true
    self.session_id = message.session_id
    msg.post(".", "acquire_input_focus")

    -- Camera follows local player
    local camera = require("orthographic.camera")
    camera.follow(nil, go.get_id())

    print("Local player set up:", self.session_id)

  elseif message_id == hash("update_from_server") then
    pprint(message)
    -- Update position from server
    if (message.x or message.y) then
      go.set_position(vmath.vector3(message.x, message.y, 0))
    end

    -- Update animation
    if message.animation and message.animation ~= self.current_animation then
      msg.post("#sprite", "play_animation", { id = hash(message.animation) })
      self.current_animation = message.animation
    end

    -- Update moving state for idle animation
    self.moving = message.moving or false

  elseif message_id == hash("destroy") then
    -- Remove this player
    go.delete()

  elseif message_id == hash(MESSAGES.PLAYER.TAKE_DAMAGE) then
    local damage = message.damage
    self.current_health = self.current_health - damage
    msg.post("/gui/gui", MESSAGES.PLAYER.SET_HEALTH,
      { health_percent = self.current_health / self.max_health })

    if self.current_health <= 0 then
      msg.post("main:/loader#script", MESSAGES.LOAD_LEVEL,
        { level = "game_over" })
    end
  end
end
