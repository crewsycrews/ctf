---@class Player
---@field moving bool
---@field dashing bool
---@field input quaternion|vector3|vector4
---@field dir quaternion|vector3|vector4
---@field speed number
---@field followers table
---@field followers_amount number
---@field buffs table
require('main.scripts.common.debugger.debugger').start()
local followersManipulator =
    require('main.scripts.modules.followersManipulator')
local camera = require("orthographic.camera")
local skills = require("main.scripts.modules.skills")
go.property('speed', 300)

local DEFAULT_SPEED = 300

---@param self Player
function init(self)
  msg.post(".", "acquire_input_focus")
  camera.follow(nil, go.get_id())

  self.moving = false
  self.dashing = false
  self.followers = {}
  self.buffs = {}
  self.input = vmath.vector3(0, 0, 0)
  self.dir = vmath.vector3(1, 0, 0)
  followersManipulator.spawn_followers(self)
end

---@param self Player
function final(self) msg.post(".", "release_input_focus") end

---@param self Player
function update(self, dt)
  local target_position = go.get_position()
  if self.dashing then self.speed = self.speed * 10 end
  target_position = target_position + self.dir * self.speed * dt
  go.set_position(target_position)
  -- go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD, target_position,
  --            go.EASING_OUTBOUNCE, 0.05)
  self.speed = DEFAULT_SPEED
  self.input.x = 0
  self.input.y = 0
  self.dir = vmath.normalize(self.dir)
  self.dashing = false
end

---@param self Player
function on_input(self, action_id, action)
  if action_id == hash("up") then
    self.input.y = 1
  elseif action_id == hash("down") then
    self.input.y = -1
  elseif action_id == hash("left") then
    self.input.x = -1
  elseif action_id == hash("right") then
    self.input.x = 1
  elseif action_id == hash("head_action_1") and action.pressed then
    skills.dash(self)
  elseif action_id == hash("head_action_2") and action.pressed then
    skills.jump(self)
  end

  if vmath.length(self.input) > 0 then
    self.dir = vmath.normalize(self.input)
    msg.post('/sprite', "look_at", { dir = self.dir })
  end
end
