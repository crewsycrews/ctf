go.property("health", 500)

function init(self)
  self.max_health = self.health
  -- Health is now managed by server
  -- Totem only receives SET_HEALTH messages from network_manager
end

function on_message(self, message_id, message)
  -- Remove TAKE_DAMAGE handler - server handles damage now
  -- Keep only SET_HEALTH handler for GUI updates from network_manager
  if message_id == hash(MESSAGES.TOTEM.SET_HEALTH) then
    msg.post("/gui", MESSAGES.TOTEM.SET_HEALTH, {
      health_percent = message.health_percent
    })
  end
end

function update(self, dt)
  -- Remove game over check - server handles defeat condition
end
