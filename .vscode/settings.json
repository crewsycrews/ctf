{
  // Editor
  "editor.suggest.localityBonus": true,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.showWords": false,
  "vscode-lua-format.configPath": ".vscode/lua-format.config",

  "workbench.iconTheme": "material-icon-theme",
  // Lua tab size
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua",
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 2
  },
  "[script]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[gui_script]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[render_script]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "[editor_script]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },

  // Files
  "files.associations": {
    "*.sqlbook": "sql",
    "*.ndjson": "jsonl",
    "*.dbclient-js": "javascript",
    "*.php": "php",
    "*.blade.php": "blade",
    "*.project": "ini",
    "*.script": "lua",
    "*.gui_script": "lua",
    "*.render_script": "lua",
    "*.editor_script": "lua",
    "*.fp": "glsl",
    "*.vp": "glsl",
    "*.go": "textproto",
    "*.animationset": "textproto",
    "*.atlas": "textproto",
    "*.buffer": "json",
    "*.camera": "textproto",
    "*.collection": "textproto",
    "*.collectionfactory": "textproto",
    "*.collectionproxy": "textproto",
    "*.collisionobject": "textproto",
    "*.display_profiles": "textproto",
    "*.factory": "textproto",
    "*.gamepads": "textproto",
    "*.gui": "textproto",
    "*.input_binding": "textproto",
    "*.label": "textproto",
    "*.material": "textproto",
    "*.mesh": "textproto",
    "*.model": "textproto",
    "*.particlefx": "textproto",
    "*.render": "textproto",
    "*.sound": "textproto",
    "*.spinemodel": "textproto",
    "*.spinescene": "textproto",
    "*.sprite": "textproto",
    "*.texture_profiles": "textproto",
    "*.tilemap": "textproto",
    "*.tilesource": "textproto",
    "*.manifest": "textproto",
    "*.appmanifest": "yaml",
    "*.script_api": "yaml",
    "ext.manifest": "yaml"
  },
  "glsllint.additionalStageAssociations": {
    ".fp": "frag",
    ".vp": "vert"
  },

  "editor.formatOnSave": true,

  // Lua Language Server
  "Lua.runtime.version": "Lua 5.1",
  "Lua.completion.callSnippet": "Replace",
  "Lua.completion.displayContext": 0,
  "Lua.completion.workspaceWord": false,
  "Lua.completion.keywordSnippet": "Replace",
  "Lua.diagnostics.globals": [
    "msg",
    "sound",
    "hash",
    "vmath",
    "gui",
    "socket",
    "sys",
    "render",
    "go",
    "factory",
    "resource",
    "pprint",
    "timer",
    "particlefx",
    "spine",
    "sprite",
    "json",
    "window",
    "physics"
  ],
  "Lua.diagnostics.disable": [
    "lowercase-global",
    "trailing-space",
    "redefined-local",
    "missing-parameter"
  ],
  "Lua.workspace.ignoreDir": [".vscode", ".internal", ".defold_api"],
  "Lua.workspace.library": [
    ".internal",
    ".defold_api",
    "~/.config/Code/User/globalStorage/astronachos.defold",
    "~/.config/Code/User/workspaceStorage/39082a2e4c3d1b95f60c556ce3763aa7/astronachos.defold",
    "~\\AppData\\Roaming\\Code\\User\\workspaceStorage\\939bd02b3ad90aea5af8cbf1ad527832\\astronachos.defold",
    "~\\AppData\\Roaming\\Code\\User\\globalStorage\\astronachos.defold"
  ],
  "Lua.workspace.checkThirdParty": false,
  "Lua.runtime.pathStrict": true,
  "Lua.window.statusBar": true,
  "Lua.completion.showWord": "Fallback",
  "Lua.completion.autoRequire": false,
  "Lua.diagnostics.libraryFiles": "Disable"
}
