{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build & Run",
      "type": "lua-local",
      "request": "launch",
      "stopOnEntry": false,
      "verbose": false,
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}",
      "program": {
        "command": "${workspaceFolder}/build/defoldkit/dmengine"
      },
      "args": [
        "${workspaceFolder}/build/defoldkit/game.projectc"
      ],
      "windows": {
        "program": {
          "command": "${workspaceFolder}/build/defoldkit/dmengine.exe"
        }
      },
      "preLaunchTask": "Build"
    },
    {
      "name": "Just Run",
      "type": "lua-local",
      "request": "launch",
      "stopOnEntry": false,
      "verbose": false,
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}",
      "program": {
        "command": "${workspaceFolder}/build/defoldkit/dmengine"
      },
      "args": [
        "${workspaceFolder}/build/defoldkit/game.projectc"
      ],
      "windows": {
        "program": {
          "command": "${workspaceFolder}/build/defoldkit/dmengine.exe"
        }
      }
    }
  ]
}
