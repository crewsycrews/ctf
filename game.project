[project]
title = CTF
version = 0.1
dependencies#0 = https://github.com/britzl/defold-orthographic/archive/master.zip

[bootstrap]
main_collection = /main/main.collectionc
render = /orthographic/render/orthographic.renderc

[input]
game_binding = /input/game.input_bindingc

[physics]
scale = 0.02
gravity_y = 0.0

[script]
shared_state = 1

[tilemap]
max_tile_count = 10000

[display]
display_device_info = 1
width = 960
height = 640

[render]
clear_color_alpha = 1.0
clear_color_red = 0.15
clear_color_green = 0.68
clear_color_blue = 0.38

